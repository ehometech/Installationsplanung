# Nur in den Umgebungsvariablen des Hosters (z. B. Vercel → Settings → Environment Variables) setzen.
# Diese Datei NIE mit echten Werten ins Repository einchecken.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Firebase-Web-API-Key (öffentlicher Key aus der Firebase-Konfiguration, dient zur Prüfung der Anmeldung)
FIREBASE_WEB_API_KEY=
# Erlaubte Browser-Herkunft(en), kommagetrennt
ALLOWED_ORIGINS=https://ehometech.github.io
# Optional: nur diese Konten dürfen die KI nutzen
ALLOWED_EMAILS=
ALLOWED_UIDS=
RATE_LIMIT_PER_HOUR=30
